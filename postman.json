            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorization_code\": \"{{authorization_code}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "if (pm.response.code < 300) { const data = pm.response.json();",
              "if (data.access_token) pm.collectionVariables.set(\"jwt\", data.access_token);",
              "if (data.grant_id) pm.collectionVariables.set(\"grant_id\", data.grant_id);",
              "}"
            ]
          }
        }
      ]
    },
